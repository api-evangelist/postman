        {
          "id": "9dadf695-beba-4d5d-90b2-0b79cdb985eb",
          "name": "Revoke an OAuth Token",
          "request": {
            "name": "Revoke an OAuth Token",
            "description": {
              "content": "Revokes an active OAuth 2.0 access token and prevents further use of it for authentication. Once revoked, the token can't be used for any API requests.\n\n**Note:**\n\n- Revocation of an OAuth token is immediate and can't be undone.\n- This request does not use any authorization.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth2",
                "token",
                "revoke"
              ],
              "host": [
                "{{oauth2-token-revoke-Url}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
