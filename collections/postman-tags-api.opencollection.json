  },
  "items": [
    {
      "info": {
        "name": "tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get an API's tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.postman.com/apis/:apiId/tags",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              },
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "apiId",
                "value": "",
                "type": "path",
                "description": "The API's ID."
              }
            ]
          },
          "docs": "Gets all the tags associated with an API."
        },
        {
          "info": {
            "name": "Update an API's tags",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.postman.com/apis/:apiId/tags",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              },
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "apiId",
                "value": "",
                "type": "path",
                "description": "The API's ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an API's associated tags. This endpoint replaces all existing tags with those you pass in the request body."
        },
        {
          "info": {
            "name": "Get a collection's tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.postman.com/collections/:collectionId/tags",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "collectionId",
                "value": "",
                "type": "path",
                "description": "The collection's unique ID."
              }
            ]
          },
          "docs": "Gets all the tags associated with a collection."
        },
        {
          "info": {
            "name": "Update a collection's tags",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.postman.com/collections/:collectionId/tags",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "collectionId",
                "value": "",
                "type": "path",
                "description": "The collection's unique ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a collection's associated tags. This endpoint replaces all existing tags with those you pass in the request body."
        },
        {
          "info": {
            "name": "Get elements by tag",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.postman.com/tags/:slug/entities",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "slug",
                "value": "",
                "type": "path",
                "description": "The tag's ID within a team or individual (non-team) user scope."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The maximum number of tagged elements to return in a single call."
              },
              {
                "name": "direction",
                "value": "",
                "type": "query",
                "description": "The ascending (`asc`) or descending (`desc`) order to sort the results by, based on the time of the entity's tagging."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "The cursor to get the next set of results in the paginated response. If you pass an invalid value, the API only returns the first set of results."
              },
              {
                "name": "entityType",
                "value": "",
                "type": "query",
                "description": "Filter results for the given entity type."
              }
            ]
          },
          "docs": "Gets Postman elements (entities) by a given tag. Tags enable you to organize and search [workspaces](https://learning.postman.com/docs/collaborating-in-postman/using-workspaces/managing-workspaces/#tagging-a-workspace), [APIs](https://learning.postman.com/docs/designing-and-developing-your-api/managing-apis/#tagging-apis), and [collections](https://learning.postman.com/docs/collections/using-collections/#tagging-a-collection) that contain shared tags.\n\n**Note:**\n\nTagging is available on Postman "
        },
        {
          "info": {
            "name": "Get a workspace's tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.postman.com/workspaces/:workspaceId/tags",
