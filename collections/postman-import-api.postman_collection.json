          "name": "Import an OpenAPI definition",
          "request": {
            "name": "Import an OpenAPI definition",
            "description": {
              "content": "Imports an OpenAPI definition into Postman as a new [Postman Collection](https://learning.postman.com/docs/getting-started/creating-the-first-collection/).\n\n**Note:**\n\n- This endpoint has a rate limit of **10 requests per 10 seconds**.\n- The Postman web app does not support the `file` input method type.\n- If you do not include the `workspace` query parameter, the system imports the definition into the oldest personal Internal workspace you own.\n- For an example of importing a file, see the [Postman API collection](https://www.postman.com/postman/postman-public-workspace/example/12959542-08d74ce2-8150-4f72-99a7-11e60492eb47).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "import",
                "openapi"
              ],
              "host": [
                "{{import-openapi-Url}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "workspace",
                  "value": "<string>",
                  "description": "(Required) The workspace's ID."
                }
              ],
              "variable": []
            },
