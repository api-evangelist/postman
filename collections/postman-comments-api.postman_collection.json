          "request": {
            "name": "Resolve a comment thread",
            "description": {
              "content": "Resolves a comment and any associated replies. On success, this returns an HTTP `204 No Content` response.\n\nComment thread IDs return in the GET `/comments` response for [collections](https://www.postman.com/postman/workspace/postman-public-workspace/request/12959542-a6582e0a-9382-4760-8b91-53a8aa6cb8d7) and [collection items](https://www.postman.com/postman/workspace/postman-public-workspace/folder/12959542-efeda219-66e1-474c-a83b-253d15723bf7).\n",
              "type": "text/plain"
            },
            "url": {
