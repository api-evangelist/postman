          "http": {
            "method": "POST",
            "url": "https://api.postman.com/collections",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "query",
                "description": "The workspace's ID."
