                "description": "The API's ID."
              }
            ]
          },
          "docs": "Returns the status of an API Builder definition's migration to Spec Hub."
        },
        {
          "info": {
            "name": "Migrate API Builder API to Spec Hub",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.postman.com/apis/:apiId/spec-migrations",
            "headers": [
              {
                "name": "x-api-key",
